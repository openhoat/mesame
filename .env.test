# Test Environment Configuration
# Used by E2E and integration tests

# Database configuration (relative to project root)
DATABASE_URL=file:./test.db

# Use mock provider to avoid real API calls
MESAME_PROVIDER=mock
MESAME_MODEL=mock-model

# Server configuration for tests
# Web server on port 3000 (for E2E tests)
MESAME_WEB_PORT=3000
MESAME_LLM_PORT=3001
MESAME_WEB_HOST=localhost
MESAME_LLM_HOST=localhost
MESAME_LOG_LEVEL=silent
