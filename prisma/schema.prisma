datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model Source {
  id        String          @id @default(uuid())
  title     String
  content   String
  createdAt DateTime        @default(now())
  profiles  ProfileSource[]
}

model StyleProfile {
  id            String          @id @default(uuid())
  name          String
  personaPrompt String // The generated system prompt
  metrics       String // JSON of stats (avg sentence length, etc.)
  isActive      Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  sources       ProfileSource[]
}

model ProfileSource {
  profileId String
  sourceId  String
  profile   StyleProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  source    Source       @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([profileId, sourceId])
  @@index([profileId])
  @@index([sourceId])
}

model Provider {
  id          Int      @id @default(autoincrement())
  type        String // openai, anthropic, ollama, google
  name        String   @unique // User-defined instance name
  displayName String // "OpenAI", "Anthropic", etc.
  baseUrl     String // API endpoint
  apiKey      String? // API key (optional for ollama)
  enabled     Boolean  @default(false)
  priority    Int      @default(0) // Order in UI
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([name])
  @@index([enabled])
}

model Conversation {
  id        String   @id @default(uuid())
  title     String
  messages  String // JSON array of ChatMessage objects
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}