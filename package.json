{
  "name": "mesame",
  "productName": "MeSame",
  "version": "0.1.0",
  "description": "Your personal style proxy — a local meta-agent that transforms any LLM into your digital twin",
  "license": "MIT",
  "author": "Olivier Penhoat <openhoat@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openhoat/mesame.git"
  },
  "type": "module",
  "private": true,
  "main": "dist-electron/electron/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:renderer": "vite --config electron/renderer/vite.config.ts",
    "dev:electron": "npm run build:renderer && npm run build:electron && electron . --ozone-platform=x11 --disable-vulkan",
    "build": "wireit",
    "build:electron": "wireit",
    "build:all": "wireit",
    "start": "node dist/server.js",
    "start:electron": "electron . --ozone-platform=x11 --disable-vulkan",
    "test": "wireit",
    "test:watch": "vitest",
    "test:coverage": "wireit",
    "test:e2e": "wireit",
    "test:e2e:ui": "UI_MODE=true playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headless": "wireit",
    "qa": "wireit",
    "qa:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "wireit",
    "validate": "wireit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "changelog": "bash scripts/changelog.sh",
    "pack": "wireit",
    "dist": "wireit"
  },
  "build": {
    "appId": "com.mesame.app",
    "productName": "MeSame",
    "directories": {
      "output": "dist-electron-app"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "prisma/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "prisma",
        "to": "prisma"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/MeSame_icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "assets/MeSame_icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "assets/MeSame_icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility"
    }
  },
  "dependencies": {
    "@fastify/cors": "11.0.0",
    "@fastify/multipart": "9.4.0",
    "@fastify/static": "9.0.0",
    "@langchain/anthropic": "0.3.22",
    "@langchain/core": "0.3.80",
    "@langchain/ollama": "0.2.3",
    "@langchain/openai": "0.5.8",
    "@prisma/client": "6.5.0",
    "clsx": "2.1.1",
    "compromise": "14.14.3",
    "fastify": "5.3.2",
    "langchain": "0.3.25",
    "natural": "8.0.1",
    "pdf-parse": "2.4.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "3.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@commitlint/cli": "20.5.0",
    "@commitlint/config-conventional": "20.5.0",
    "@playwright/test": "1.58.2",
    "@tailwindcss/vite": "4.2.1",
    "@types/natural": "6.0.1",
    "@types/node": "25.5.0",
    "@types/pdf-parse": "1.1.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "3.2.4",
    "electron": "41.0.3",
    "electron-builder": "26.8.1",
    "pino-pretty": "13.1.3",
    "playwright": "1.58.2",
    "playwright-core": "1.58.2",
    "prisma": "6.5.0",
    "tailwindcss": "4.2.1",
    "tsx": "4.19.4",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "wireit": "0.14.12"
  },
  "wireit": {
    "qa": {
      "command": "biome check .",
      "files": [
        "biome.json",
        "src/**/*.ts",
        "electron/**/*.ts",
        "electron/renderer/src/**/*.{ts,tsx}"
      ],
      "output": []
    },
    "typecheck": {
      "command": "tsc --noEmit",
      "dependencies": [
        "db:generate"
      ],
      "files": [
        "src/**/*.ts",
        "electron/**/*.ts",
        "tsconfig.json",
        "tsconfig.electron.json"
      ],
      "output": []
    },
    "test": {
      "command": "vitest run",
      "dependencies": [
        "db:generate"
      ],
      "files": [
        "src/**/*.ts",
        "vitest.config.ts"
      ],
      "output": []
    },
    "test:coverage": {
      "command": "vitest run --coverage",
      "dependencies": [
        "db:generate"
      ],
      "files": [
        "src/**/*.ts",
        "vitest.config.ts"
      ],
      "output": [
        "coverage/**/*"
      ]
    },
    "test:e2e": {
      "command": "playwright test",
      "dependencies": [
        "build:all",
        "db:generate"
      ],
      "files": [
        "e2e/**/*.ts",
        "playwright.config.ts",
        "src/**/*.ts",
        "electron/**/*.ts"
      ],
      "output": [
        "e2e-report/**/*",
        "test-results/**/*"
      ]
    },
    "test:e2e:headless": {
      "command": "HEADLESS=true xvfb-run -a playwright test",
      "dependencies": [
        "build:all",
        "db:generate"
      ],
      "files": [
        "e2e/**/*.ts",
        "playwright.config.ts"
      ],
      "output": [
        "e2e-report/**/*",
        "test-results/**/*"
      ]
    },
    "build": {
      "command": "tsc",
      "dependencies": [
        "db:generate"
      ],
      "files": [
        "src/**/*.ts",
        "tsconfig.json"
      ],
      "output": [
        "dist/**/*"
      ]
    },
    "build:all": {
      "dependencies": [
        "build",
        "build:electron",
        "build:renderer"
      ]
    },
    "build:electron": {
      "command": "tsc -p tsconfig.electron.json",
      "dependencies": [
        "build"
      ],
      "files": [
        "electron/**/*.ts",
        "tsconfig.electron.json"
      ],
      "output": [
        "dist-electron/**/*"
      ]
    },
    "build:renderer": {
      "command": "vite build --config electron/renderer/vite.config.ts",
      "files": [
        "electron/renderer/src/**/*",
        "electron/renderer/vite.config.ts",
        "electron/renderer/index.html",
        "electron/renderer/tsconfig.json"
      ],
      "output": [
        "electron/renderer/dist/**/*"
      ]
    },
    "validate": {
      "dependencies": [
        "qa",
        "typecheck",
        "test:coverage"
      ]
    },
    "pack": {
      "command": "electron-builder --dir",
      "dependencies": [
        "build:all"
      ],
      "files": [
        "package.json",
        "assets/**/*",
        "prisma/**/*"
      ],
      "output": [
        "dist-electron-app/**/*"
      ]
    },
    "dist": {
      "command": "electron-builder",
      "dependencies": [
        "build:all"
      ],
      "files": [
        "package.json",
        "assets/**/*",
        "prisma/**/*"
      ],
      "output": [
        "dist-electron-app/**/*"
      ]
    }
  }
}
