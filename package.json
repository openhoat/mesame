{
  "name": "mesame",
  "version": "0.1.0",
  "description": "Your personal style proxy — a local meta-agent that transforms any LLM into your digital twin",
  "license": "MIT",
  "author": "Olivier Penhoat <openhoat@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openhoat/mesame.git"
  },
  "type": "module",
  "bin": {
    "mesame": "bin/mesame"
  },
  "overrides": {
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "@types/react": "19.2.14"
  },
  "scripts": {
    "sync:ai:specs": "tsx scripts/sync-ai-specs.ts",
    "sync:ai:specs:check": "tsx scripts/sync-ai-specs.ts --check",
    "build": "wireit",
    "build:all": "wireit",
    "build:web": "wireit",
    "changelog": "bash scripts/changelog.sh",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "dev": "wireit",
    "dev:back": "wireit",
    "dev:front": "wireit",
    "docs:build": "vitepress build docs",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "format": "biome format --write .",
    "qa": "wireit",
    "qa:fix": "biome check --write .",
    "start": "node dist/server/server.js",
    "test": "wireit",
    "test:coverage": "wireit",
    "test:e2e": "playwright test",
    "test:e2e:headless": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:watch": "vitest",
    "typecheck": "wireit",
    "validate": "wireit"
  },
  "dependencies": {
    "@fastify/cors": "11.2.0",
    "@fastify/multipart": "9.4.0",
    "@fastify/static": "9.0.0",
    "@langchain/anthropic": "0.3.22",
    "@langchain/core": "0.3.80",
    "@langchain/ollama": "0.2.3",
    "@langchain/openai": "0.5.8",
    "@mantine/core": "8.3.18",
    "@mantine/hooks": "8.3.18",
    "@prisma/adapter-libsql": "^7.6.0",
    "@prisma/client": "7.6.0",
    "@libsql/client": "0.8.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "commander": "14.0.3",
    "compromise": "14.15.0",
    "dotenv": "17.3.1",
    "fastify": "5.8.4",
    "i18next": "26.0.1",
    "i18next-browser-languagedetector": "8.2.1",
    "langchain": "0.3.25",
    "lucide-react": "1.7.0",
    "natural": "8.1.1",
    "pdf-parse": "2.4.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-i18next": "16.6.5",
    "react-router-dom": "6.30.3",
    "tailwind-merge": "3.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.9",
    "@commitlint/cli": "20.5.0",
    "@commitlint/config-conventional": "20.5.0",
    "@playwright/test": "1.58.2",
    "@tailwindcss/vite": "4.2.2",
    "@types/natural": "6.0.1",
    "@types/node": "25.5.0",
    "@types/pdf-parse": "1.1.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "4.1.2",
    "pino-pretty": "13.1.3",
    "prisma": "7.6.0",
    "tailwindcss": "4.2.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitepress": "1.6.4",
    "vitest": "3.2.4",
    "wireit": "0.14.12"
  },
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "productName": "MeSame",
  "wireit": {
    "build": {
      "command": "tsc",
      "dependencies": [
        "db:generate"
      ],
      "files": [
        "src/**/*.ts",
        "tsconfig.json"
      ],
      "output": [
        "dist/server/**/*"
      ]
    },
    "build:all": {
      "dependencies": [
        "build",
        "build:web"
      ]
    },
    "build:web": {
      "command": "vite build --config web/vite.config.ts",
      "files": [
        "web/src/**/*",
        "web/vite.config.ts",
        "web/index.html",
        "web/tsconfig.json"
      ],
      "output": [
        "dist/web/**/*"
      ]
    },
    "qa": {
      "command": "biome check .",
      "files": [
        "biome.json",
        "src/**/*.ts",
        "web/src/**/*.{ts,tsx}"
      ],
      "output": []
    },
    "test": {
      "command": "vitest run",
      "dependencies": [
        "db:generate"
      ],
      "files": [
        "src/**/*.ts",
        "vitest.config.ts"
      ],
      "output": []
    },
    "test:coverage": {
      "command": "vitest run --coverage",
      "dependencies": [
        "db:generate"
      ],
      "files": [
        "src/**/*.ts",
        "vitest.config.ts"
      ],
      "output": [
        "dist/coverage/**/*"
      ]
    },
    "typecheck": {
      "command": "tsc --noEmit",
      "dependencies": [
        "db:generate"
      ],
      "files": [
        "src/**/*.ts",
        "web/src/**/*.{ts,tsx}",
        "tsconfig.json",
        "web/tsconfig.json"
      ],
      "output": []
    },
    "validate": {
      "dependencies": [
        "qa",
        "typecheck",
        "test:coverage"
      ]
    },
    "dev": {
      "dependencies": [
        "dev:back",
        "dev:front"
      ]
    },
    "dev:back": {
      "command": "tsx watch src/server.ts",
      "dependencies": [
        "db:generate"
      ],
      "files": [
        "src/**/*.ts",
        "tsconfig.json"
      ],
      "service": true
    },
    "dev:front": {
      "command": "vite --config web/vite.config.ts",
      "files": [
        "web/src/**/*",
        "web/vite.config.ts",
        "web/index.html",
        "web/tsconfig.json"
      ],
      "service": true
    }
  }
}
