{
  "name": "mesame",
  "version": "0.1.0",
  "description": "Your personal style proxy — a local meta-agent that transforms any LLM into your digital twin",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "qa": "biome check .",
    "qa:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "validate": "npm run qa && npm run typecheck && npm run test",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "compromise": "^14.14.3",
    "fastify": "^5.3.2",
    "@fastify/cors": "^11.0.0",
    "@fastify/static": "^8.1.0",
    "langchain": "^0.3.25",
    "@langchain/core": "^0.3.51",
    "@langchain/openai": "^0.5.8",
    "@langchain/anthropic": "^0.3.22",
    "@langchain/ollama": "^0.2.3",
    "natural": "^8.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@types/natural": "^6.0.1",
    "@types/node": "^22.15.3",
    "prisma": "^6.5.0",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3",
    "vitest": "^3.1.3"
  },
  "author": "Olivier Penhoat <openhoat@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openhoat/mesame.git"
  }
}
