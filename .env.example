# MeSame Configuration
# All MeSame-specific environment variables are prefixed with MESAME_
#
# NOTE: Most settings have sensible defaults and don't need to be set.

# =============================================================================
# SERVER CONFIGURATION
# These are always used, regardless of deployment mode.

# LLM API Server (default: 3001, localhost)
# MESAME_LLM_PORT=3001
# MESAME_LLM_HOST=localhost

# Web Dashboard Server (default: 3000, localhost)
# MESAME_WEB_PORT=3000
# MESAME_WEB_HOST=localhost

# LLM server URL for web dashboard proxy (default: http://localhost:3001)
# For Docker: use http://llm:3001 (service name)
# MESAME_LLM_URL=http://localhost:3001

# Logging level: fatal, error, warn, info, debug, trace, silent (default: info)
# MESAME_LOG_LEVEL=info

# Language for style detection and responses (default: auto-detected from system)
# MESAME_LANGUAGE=en

# =============================================================================
# DOCKER / TRAEFIK CONFIGURATION
# For production deployments with Traefik reverse proxy.

# Virtual host for web dashboard (default: mesame.localdomain)
# MESAME_WEB_VIRTUAL_HOST=mesame.example.com

# Virtual host for LLM API (default: mesame-llm.localdomain)
# MESAME_LLM_VIRTUAL_HOST=mesame-llm.example.com

# Docker Registry (default: none)
# MESAME_DOCKER_REGISTRY=my-registry.example.com:5000

# =============================================================================
# CORS CONFIGURATION
# Configure allowed origins for cross-origin requests.
# Essential when deploying frontend on a different domain than the API.

# Allowed origins (comma-separated for multiple, or * for all)
# Development: not set (allows all origins)
# Production CDN: set to your frontend URL
# Examples:
#   CORS_ORIGIN=https://app.mesame.com
#   CORS_ORIGIN=https://app.mesame.com,https://admin.mesame.com
#   CORS_ORIGIN=* (allows all origins - not recommended for production)
# CORS_ORIGIN=https://app.mesame.com

# =============================================================================
# API KEYS (for cloud providers)
# These can also be configured via the web dashboard.
# API keys set here will be used as fallback if not found in database.
# OPENAI_API_KEY=sk-xxx
# ANTHROPIC_API_KEY=sk-ant-xxx
# GOOGLE_API_KEY=xxx

# =============================================================================
# DEVELOPMENT / CLI MODE ONLY
# The following variables are ONLY used when running the combined server
# or CLI. When using Docker with separate services, providers are configured
# via the web dashboard and stored in the database.

# Default provider: openai, anthropic, google, ollama, mock (default: ollama)
# MESAME_PROVIDER=ollama

# Default model (default depends on provider: gemma3:1b for ollama, gpt-4o for others)
# MESAME_MODEL=gemma3:1b

# Target API base URL (default depends on provider)
# MESAME_TARGET_BASE_URL=http://localhost:11434

# =============================================================================
# VITE DEV SERVER (development only)
# MESAME_DEV_PORT=5173
