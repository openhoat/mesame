# MeSame Configuration
# All MeSame-specific environment variables are prefixed with MESAME_

# Server Configuration
MESAME_PORT=3000
MESAME_HOST=127.0.0.1
MESAME_LOG_LEVEL=info

# Provider Configuration
# Valid providers: openai, anthropic, google, ollama
MESAME_PROVIDER=openai

# Model Selection (default depends on provider)
MESAME_MODEL=gpt-4o

# API Keys (standard environment variables, no prefix)
# Set the one corresponding to your MESAME_PROVIDER
OPENAI_API_KEY=sk-xxx
# ANTHROPIC_API_KEY=sk-ant-xxx
# GOOGLE_API_KEY=xxx

# Optional: Override default API base URL
# MESAME_TARGET_BASE_URL=https://api.openai.com