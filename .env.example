# MeSame Configuration
# All MeSame-specific environment variables are prefixed with MESAME_
#
# NOTE: Most settings have sensible defaults and don't need to be set.
# Default values:
#   MESAME_PROVIDER=ollama
#   MESAME_MODEL=gemma3:1b (for ollama) or gpt-4o (for other providers)
#   MESAME_PORT=3000
#   MESAME_HOST=localhost
#   MESAME_LOG_LEVEL=info
#   MESAME_LANGUAGE=auto-detected from system locale

# Server Configuration (optional, defaults shown)
# MESAME_PORT=3000
# MESAME_HOST=127.0.0.1
# MESAME_LOG_LEVEL=info

# Provider Configuration (optional)
# Valid providers: openai, anthropic, google, ollama
# Default: ollama
# MESAME_PROVIDER=ollama

# Model Selection (optional, default depends on provider)
# Default: gemma3:1b for ollama, gpt-4o for others
# MESAME_MODEL=gemma3:1b

# API Keys (only needed for cloud providers, not for ollama)
# Standard environment variables without MESAME_ prefix
# OPENAI_API_KEY=sk-xxx
# ANTHROPIC_API_KEY=sk-ant-xxx
# GOOGLE_API_KEY=xxx

# Optional: Override default API base URL (works for all providers)
# MESAME_TARGET_BASE_URL=https://api.openai.com
# Examples:
#   - For Ollama: MESAME_TARGET_BASE_URL=http://localhost:11434
#   - For OpenAI: MESAME_TARGET_BASE_URL=https://api.openai.com
#   - For custom endpoint: MESAME_TARGET_BASE_URL=http://custom-server:8080

# Optional: Force a specific language (auto-detected by default)
# MESAME_LANGUAGE=fr

# Database Configuration (optional, defaults to file:./prisma/dev.db)
# DATABASE_URL=file:./prisma/dev.db